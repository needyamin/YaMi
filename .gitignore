kaggle.json
.ipynb_checkpoints/

# ---- Environment / IDE ----
.env
.idea/
.vscode/
.DS_Store

# ---- Local agent memory (never commit; see .cursor/rules/context-memory.mdc) ----
CONTEXT_MEMORY.txt
