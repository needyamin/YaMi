# Copy this file to `.env` (same folder) and adjust.

# Which checkpoint the chat UI serves.
# Container path of a run's `checkpoints` folder — the loader automatically
# picks the newest step inside it. After a fresh training run, replace the
# run-folder name below with the one printed by the trainer.
# A missing folder fails at startup until this points at a real run.
FONTAINE_CHECKPOINT=/app/experiments/2026-09-22_104709_smoke-codealpaca/checkpoints

# Host port for the Fontaine inference API (container always listens on 8321).
FONTAINE_PORT=8321

# Host port for Open WebUI (the Ollama-style chat UI; container listens on 8080).
WEBUI_PORT=3000
